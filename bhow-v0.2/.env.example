# Local development only. NEVER enable development identity headers in production.
BH_APP_ENV=local
BH_DATABASE_URL=sqlite:///./bhow.db
BH_ALLOW_DEV_AUTH=true
BH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8550
# In production:
# BH_APP_ENV=production
# BH_DATABASE_URL=postgresql+psycopg://bhow:YOUR_PASSWORD@db:5432/bhow
# BH_ALLOW_DEV_AUTH=false
# BH_OIDC_ISSUER=https://YOUR-IDP/
# BH_OIDC_AUDIENCE=bhow-api
# BH_OIDC_JWKS_URL=https://YOUR-IDP/.well-known/jwks.json
# BH_ALLOWED_ORIGINS=https://app.example.com

# Telemetry & Monitoring
BHOW_ENABLE_METRICS=true
